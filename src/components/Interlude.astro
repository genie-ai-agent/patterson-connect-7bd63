<section class="relative overflow-hidden border-y-2 border-ink bg-block-1 text-block-1-foreground">
  <div class="relative mx-auto w-full max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <span
      class="deco pointer-events-none absolute -left-5 -top-6 text-[11rem] text-block-1-foreground/15 sm:text-[16rem]"
      aria-hidden="true"
    >
      &ldquo;
    </span>

    <div class="relative grid grid-cols-12 items-center gap-x-5 gap-y-7">
      <blockquote class="col-span-12 lg:col-span-8">
        <p class="font-heading text-[clamp(1.75rem,7vw,3.4rem)] italic leading-[1.02]">
          Nobody in this town is going to knock on your door. But every single one of
          these rooms has an empty chair in it, and the people already sitting there have
          been hoping somebody takes it.
        </p>
        <footer class="kicker mt-5 text-block-1-foreground/80">
          The whole premise of this page
        </footer>
      </blockquote>

      <div class="col-span-12 lg:col-span-4">
        <div
          class="tilt-r mx-auto w-fit border-2 border-ink bg-secondary px-6 py-5 text-center text-secondary-foreground shadow-xl lg:ml-auto lg:mr-0"
        >
          <span class="deco block text-[4.5rem] sm:text-[5.5rem]">5</span>
          <p class="kicker mt-2 border-t-2 border-ink pt-2">
            minutes on the phone<br />is the whole hard part
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
