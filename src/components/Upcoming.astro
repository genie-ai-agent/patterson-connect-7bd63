---
import { upcoming } from '../data/opportunities';
---

<section id="calendar" class="relative overflow-hidden border-y-2 border-ink bg-card">
  <div class="relative mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
    <!-- oversized decoration -->
    <span
      class="deco pointer-events-none absolute -right-8 bottom-2 hidden text-[13rem] text-block-4/12 lg:block"
      aria-hidden="true"
    >
      52
    </span>

    <div class="grid grid-cols-12 gap-x-4 gap-y-4">
      <div class="col-span-12 md:col-span-7">
        <p class="kicker text-block-4">Put it on the fridge</p>
        <h2 class="mt-3 font-heading text-[clamp(2.3rem,9vw,4.75rem)]">
          The rhythm<br />
          <span class="italic text-block-4">of the town</span>
        </h2>
      </div>
      <div class="col-span-12 self-end md:col-span-5">
        <div class="typeset max-w-prose border-l-4 border-block-4 pl-4">
          <p>
            Weekly stuff you can drop into, and the big annual weekends worth planning
            around. Always call ahead the first time &mdash; small-town schedules move.
          </p>
        </div>
      </div>
    </div>

    <ul class="mt-10 border-t-2 border-ink">
      {
        upcoming.map((row, i) => (
          <li
            class="reveal group grid grid-cols-12 items-baseline gap-x-3 gap-y-1 border-b border-ink/35 py-4 transition-colors hover:bg-secondary/35 sm:gap-x-5 sm:py-5"
            data-delay={i * 60}
          >
            <span
              class="deco col-span-2 text-2xl text-primary/60 sm:col-span-1 sm:text-3xl"
              aria-hidden="true"
            >
              {String(i + 1).padStart(2, '0')}
            </span>
            <span
              class="col-span-10 font-heading text-xl italic leading-tight sm:col-span-3 sm:text-2xl"
            >
              {row.when}
            </span>
            <span
              class="col-span-12 text-[1.0625rem] font-black uppercase leading-[1.15] tracking-[-0.01em] sm:col-span-5 sm:text-lg"
            >
              {row.what}
            </span>
            <span class="col-span-12 text-sm text-muted-foreground sm:col-span-3 sm:text-right">
              {row.note}
            </span>
          </li>
        ))
      }
    </ul>

    <div
      class="tilt-l mt-10 inline-block border-2 border-ink bg-block-2 px-5 py-3 text-block-2-foreground shadow-md"
    >
      <p class="kicker">Rec office &middot; (209) 895-8080 &middot; call first</p>
    </div>
  </div>
</section>
