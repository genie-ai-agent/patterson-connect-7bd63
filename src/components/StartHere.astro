---
import { opportunities, startHere } from '../data/opportunities';
import { Badge } from './ui/badge';

const picks = startHere
  .map((id) => opportunities.find((o) => o.id === id))
  .filter((o): o is NonNullable<typeof o> => Boolean(o));

const steps = [
  'Three bucks, walk in, rotate through games with strangers. Nobody needs a partner.',
  'Call, ask which program needs an extra set of hands this week, show up for that one.',
  'Call, ask for the Friendly Visitor program, they walk you through orientation.',
];

const blocks = [
  { bg: 'bg-block-4', fg: 'text-block-4-foreground', rule: 'border-block-4' },
  { bg: 'bg-block-2', fg: 'text-block-2-foreground', rule: 'border-block-2' },
  { bg: 'bg-block-3', fg: 'text-block-3-foreground', rule: 'border-block-3' },
];

const offsets = ['md:mt-0', 'md:mt-10', 'md:mt-20'];
const tilts = ['md:-rotate-1', '', 'md:rotate-1'];
---

<section id="start" class="relative mx-auto w-full max-w-6xl px-5 py-14 sm:px-8 sm:py-20">
  <div class="rule-heavy grid grid-cols-12 gap-x-4 gap-y-4 pt-6">
    <div class="col-span-12 md:col-span-7">
      <p class="kicker text-block-3">No overthinking</p>
      <h2 class="mt-3 font-heading text-[clamp(2.3rem,9vw,4.75rem)]">
        Start here<br />
        <span class="italic text-primary">this week</span>
      </h2>
    </div>
    <p
      class="col-span-12 self-end border-l-4 border-ink pl-4 text-base leading-relaxed md:col-span-4 md:col-start-9"
    >
      The three with the least friction between &ldquo;maybe&rdquo; and being in a room
      with people.
    </p>
  </div>

  <ol class="mt-10 grid grid-cols-1 gap-7 md:grid-cols-3 md:gap-5">
    {
      picks.map((pick, i) => (
        <li class={`reveal relative ${offsets[i]} ${tilts[i]}`} data-delay={i * 110}>
          <article class="lift relative flex h-full flex-col border-2 border-ink bg-card shadow-lg">
            <div
              class={`flex items-center justify-between gap-3 border-b-2 border-ink px-5 py-3 ${blocks[i].bg} ${blocks[i].fg}`}
            >
              <span class="deco text-4xl">{String(i + 1).padStart(2, '0')}</span>
              <span class="kicker text-right text-[0.625rem] leading-snug">
                {pick.cadence}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <h3 class="font-heading text-[1.9rem] leading-[0.95]">{pick.title}</h3>
              <p class="kicker mt-2 text-muted-foreground">{pick.org}</p>
              <p class="mt-4 flex-1 text-[1.0625rem] leading-[1.55]">{steps[i]}</p>

              <div class="mt-5 flex flex-wrap gap-2 border-t border-ink pt-4">
                {pick.contacts.map((c) => (
                  <a
                    class="inline-flex min-h-[44px] items-center border-2 border-ink bg-background px-4 py-2 text-sm font-black uppercase tracking-wide transition-colors hover:bg-primary hover:text-primary-foreground"
                    href={
                      c.kind === 'tel'
                        ? `tel:${c.value}`
                        : c.kind === 'email'
                          ? `mailto:${c.value}`
                          : c.value
                    }
                    rel={c.kind === 'url' ? 'noopener' : undefined}
                    target={c.kind === 'url' ? '_blank' : undefined}
                  >
                    {c.label}
                  </a>
                ))}
              </div>
            </div>
          </article>
        </li>
      ))
    }
  </ol>

  <div class="mt-14 flex flex-wrap items-center gap-3 border-t-2 border-ink pt-5">
    <Badge
      className="rounded-none border-2 border-ink bg-secondary px-3 py-1 font-sans text-[0.65rem] font-black uppercase tracking-[0.2em] text-secondary-foreground"
    >
      Still here?
    </Badge>
    <p class="font-heading text-xl italic sm:text-2xl">
      Then scroll. There are {opportunities.length - picks.length} more, all of them real.
    </p>
  </div>
</section>
