---
import Layout from '../layouts/Layout.astro';
import Game from '../components/vote/Game.tsx';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
  title="Patterson, Together — which should I do next?"
  description="Tap one of two. Real volunteer programs, senior center days, pickleball nights and town events in and around Patterson, CA, ranked by what the town votes for."
>
  <header class="border-b-4 border-ink bg-primary px-4 py-3 text-primary-foreground">
    <div class="mx-auto max-w-2xl">
      <p class="font-heading text-base font-black tracking-tight sm:text-lg">
        Patterson, together
      </p>
    </div>
  </header>
  <main>
    <Game client:load />
  </main>
  <SiteFooter />
</Layout>
