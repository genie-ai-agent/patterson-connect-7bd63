---
import Layout from '../layouts/Layout.astro';
import Poll from '../components/vote/Poll.tsx';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
  title="What should Catrina do? — Patterson, CA"
  description="A two-option poll: you decide what Catrina does with her week. 25 real volunteer programs, senior center days, pickleball nights and town events in and around Patterson, CA."
>
  <header class="px-5 pt-6">
    <p
      class="mx-auto max-w-xl text-center text-[0.7rem] font-bold tracking-[0.26em] text-muted-foreground uppercase"
    >
      Catrina's calendar, crowdsourced
    </p>
  </header>
  <main>
    <Poll client:load />
  </main>
  <SiteFooter />
</Layout>
